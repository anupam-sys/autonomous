# Copy to .env (or export in your shell / docker-compose environment).
# Environment variables override config.yaml.

# Optional: enables GitHub dork-based code search (huge yield increase)
GITHUB_TOKEN=

# Optional: GitLab personal access token (raises rate limits)
GITLAB_TOKEN=

# LLM triage — any OpenAI-compatible endpoint
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Discord interactive bot & notifications
DISCORD_ENABLED=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_ON=any
DISCORD_CREATE_THREADS=true
