<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FAS — NEURAL DASHBOARD</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700&family=Rajdhani:wght@400;500;600;700&family=Fira+Code:wght@300;400;500&display=swap');

  :root { 
    --bg: #030613; 
    --panel-bg: rgba(9, 14, 28, 0.65);
    --border: rgba(0, 243, 255, 0.15); 
    --border-glow: rgba(0, 243, 255, 0.4);
    --fg: #e2f1f8;
    --dim: #6b8298; 
    --accent: #00f3ff; 
    --gold: #f9c316; 
    --red: #ff2a5f;
    --green: #00ff9d; 
    --orange: #ff8c00;
    --purple: #b050ff;
    --font-sans: 'Rajdhani', sans-serif;
    --font-head: 'Orbitron', sans-serif;
    --font-mono: 'Fira Code', monospace;
  }
  
  * { box-sizing: border-box; }
  
  body { 
    margin: 0; 
    background-color: var(--bg);
    background-image: 
      radial-gradient(circle at 15% 50%, rgba(0, 243, 255, 0.05) 0%, transparent 50%),
      radial-gradient(circle at 85% 30%, rgba(176, 80, 255, 0.05) 0%, transparent 50%);
    background-attachment: fixed;
    color: var(--fg);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.5;
  }
  
  body::before {
    content: '';
    position: fixed;
    top: 0; left: 0; width: 100vw; height: 100vh;
    background-image: 
      linear-gradient(rgba(0, 243, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 243, 255, 0.03) 1px, transparent 1px);
    background-size: 30px 30px;
    z-index: -1;
    pointer-events: none;
  }

  h1, h2, h3, h4 { font-family: var(--font-head); font-weight: 500; margin: 0; text-transform: uppercase; letter-spacing: 1px; }

  header { 
    display: flex; align-items: center; gap: 16px; padding: 15px 30px;
    background: var(--panel-bg); 
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(10px);
    position: sticky; top: 0; z-index: 10;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
  }
  
  header h1 { font-size: 18px; color: var(--accent); text-shadow: 0 0 10px rgba(0, 243, 255, 0.5); }
  
  .dot { width: 12px; height: 12px; border-radius: 50%; background: var(--dim); box-shadow: 0 0 0 transparent; transition: all 0.3s; }
  .dot.live { background: var(--accent); box-shadow: 0 0 10px var(--accent), 0 0 20px var(--accent); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.8); } 100% { opacity: 1; transform: scale(1); } }
  
  .meta { color: var(--dim); font-size: 13px; font-family: var(--font-mono); }
  
  #now { 
    margin: 20px 30px; padding: 20px; 
    background: var(--panel-bg);
    border: 1px solid var(--border); 
    border-left: 4px solid var(--accent);
    border-radius: 4px; 
    backdrop-filter: blur(10px);
    font-family: var(--font-mono);
    box-shadow: inset 0 0 20px rgba(0,0,0,0.5), 0 5px 15px rgba(0,0,0,0.3);
    position: relative;
    overflow: hidden;
  }
  #now::after {
    content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(0, 243, 255, 0.1), transparent);
    animation: scanline 4s infinite linear;
    pointer-events: none;
  }
  @keyframes scanline { to { left: 200%; } }

  #now .stage { color: var(--accent); font-weight: 700; text-transform: uppercase; font-size: 12px; letter-spacing: 2px; }
  #now .msg { font-size: 14px; margin-top: 8px; word-break: break-all; color: #fff; }
  #now .ts { color: var(--dim); font-size: 11px; margin-top: 8px; text-align: right; }
  
  #funnel { display: flex; gap: 15px; margin: 0 30px 25px; flex-wrap: wrap; }
  
  .card { 
    background: var(--panel-bg); border: 1px solid var(--border); border-radius: 4px;
    padding: 15px; min-width: 120px; flex: 1;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    backdrop-filter: blur(5px); transition: all 0.3s;
    box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    position: relative;
    overflow: hidden;
  }
  .card::before {
    content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px;
    background: var(--dim); opacity: 0.5;
  }
  .card:hover { transform: translateY(-3px); border-color: var(--border-glow); box-shadow: 0 8px 15px rgba(0,0,0,0.4), 0 0 10px rgba(0,243,255,0.1); }
  
  .card .n { font-size: 32px; font-weight: 600; font-family: var(--font-head); margin-bottom: 5px; }
  .card .l { color: var(--dim); font-size: 11px; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
  
  .card.gold { border-color: rgba(249, 195, 22, 0.3); } .card.gold::before { background: var(--gold); } .card.gold .n { color: var(--gold); text-shadow: 0 0 10px rgba(249, 195, 22, 0.4); }
  .card.red { border-color: rgba(255, 42, 95, 0.3); } .card.red::before { background: var(--red); } .card.red .n { color: var(--red); text-shadow: 0 0 10px rgba(255, 42, 95, 0.4); }
  .card.green { border-color: rgba(0, 255, 157, 0.3); } .card.green::before { background: var(--green); } .card.green .n { color: var(--green); text-shadow: 0 0 10px rgba(0, 255, 157, 0.4); }
  .card.accent { border-color: rgba(0, 243, 255, 0.3); } .card.accent::before { background: var(--accent); } .card.accent .n { color: var(--accent); text-shadow: 0 0 10px rgba(0, 243, 255, 0.4); }
  
  nav.tabs { display: flex; gap: 5px; margin: 0 30px; border-bottom: 1px solid var(--border); }
  nav.tabs button { 
    background: rgba(9, 14, 28, 0.3); border: 1px solid transparent; border-bottom: none;
    color: var(--dim); padding: 12px 24px; font-family: var(--font-head);
    cursor: pointer; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;
    border-radius: 4px 4px 0 0; transition: all 0.2s;
  }
  nav.tabs button:hover { color: var(--fg); background: rgba(0, 243, 255, 0.05); }
  nav.tabs button.active { 
    color: var(--accent); border-color: var(--border); border-bottom-color: var(--bg);
    background: var(--panel-bg); text-shadow: 0 0 8px rgba(0, 243, 255, 0.5);
    position: relative; top: 1px;
  }
  
  .pane { padding: 25px 30px 50px; display: none; animation: fadeIn 0.3s; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .pane.active { display: block; }
  
  /* Activity Feed */
  #feed { font-family: var(--font-mono); font-size: 13px; background: var(--panel-bg); border: 1px solid var(--border); border-radius: 4px; padding: 10px; max-height: 600px; overflow-y: auto; }
  #feed::-webkit-scrollbar { width: 8px; } #feed::-webkit-scrollbar-thumb { background: rgba(0, 243, 255, 0.3); border-radius: 4px; } #feed::-webkit-scrollbar-track { background: rgba(0,0,0,0.2); }
  
  .ev { padding: 8px 12px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; gap: 15px; align-items: baseline; }
  .ev:last-child { border-bottom: none; }
  .ev .t { color: var(--dim); white-space: nowrap; font-size: 11px; }
  .ev .s { color: var(--purple); min-width: 100px; text-transform: uppercase; font-size: 11px; font-weight: 700; letter-spacing: 1px; }
  .ev .m { word-break: break-all; color: #ccc; }
  .ev:hover { background: rgba(255,255,255,0.03); }
  .ev.finding { background: rgba(249, 195, 22, 0.1); border-left: 2px solid var(--gold); } .ev.finding .m { color: var(--gold); }
  .ev.error { background: rgba(255, 42, 95, 0.1); border-left: 2px solid var(--red); } .ev.error .m { color: var(--red); } 
  .ev.warn { background: rgba(255, 140, 0, 0.1); border-left: 2px solid var(--orange); } .ev.warn .m { color: var(--orange); }
  
  /* Tables */
  table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13px; margin-top: 15px; }
  th, td { text-align: left; padding: 12px 15px; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: middle; }
  th { color: var(--accent); font-family: var(--font-head); font-size: 12px; font-weight: 500; letter-spacing: 1px; background: rgba(0, 243, 255, 0.05); text-transform: uppercase; border-bottom: 1px solid var(--border); }
  th:first-child { border-radius: 4px 0 0 0; } th:last-child { border-radius: 0 4px 0 0; }
  tr:hover td { background: rgba(255,255,255,0.02); }
  
  .sev { font-weight: 700; font-size: 11px; text-transform: uppercase; padding: 3px 8px; border-radius: 3px; font-family: var(--font-head); letter-spacing: 1px; display: inline-block; box-shadow: inset 0 0 5px rgba(0,0,0,0.5); }
  .sev.critical { background: rgba(255, 42, 95, 0.15); color: var(--red); border: 1px solid rgba(255, 42, 95, 0.3); }
  .sev.high { background: rgba(255, 140, 0, 0.15); color: var(--orange); border: 1px solid rgba(255, 140, 0, 0.3); }
  .sev.medium { background: rgba(249, 195, 22, 0.15); color: var(--gold); border: 1px solid rgba(249, 195, 22, 0.3); }
  .sev.low, .sev.info { background: rgba(0, 243, 255, 0.15); color: var(--accent); border: 1px solid rgba(0, 243, 255, 0.3); }
  
  code, pre { font-family: var(--font-mono); font-size: 12px; }
  code { background: rgba(0,0,0,0.5); padding: 3px 6px; border-radius: 3px; color: var(--fg); border: 1px solid rgba(255,255,255,0.1); word-break: break-all; }
  pre { white-space: pre-wrap; word-break: break-all; max-width: 550px; color: #a0b0c0; background: rgba(0,0,0,0.5); padding: 12px; border-radius: 4px; border: 1px solid var(--border); }
  
  details summary { cursor: pointer; color: var(--accent); font-weight: 600; outline: none; margin-bottom: 5px; font-family: var(--font-head); text-transform: uppercase; font-size: 11px; letter-spacing: 1px; }
  details summary:hover { color: var(--fg); text-shadow: 0 0 5px var(--accent); }
  
  .pill { padding: 3px 8px; border-radius: 3px; font-size: 10px; font-weight: 700; font-family: var(--font-head); letter-spacing: 1px; text-transform: uppercase; border: 1px solid transparent; display: inline-block; }
  .pill.true_positive { background: rgba(0, 255, 157, 0.15); color: var(--green); border-color: rgba(0, 255, 157, 0.3); }
  .pill.false_positive { background: rgba(255, 42, 95, 0.15); color: var(--red); border-color: rgba(255, 42, 95, 0.3); }
  .pill.placeholder, .pill.pending { background: rgba(107, 130, 152, 0.15); color: var(--dim); border-color: rgba(107, 130, 152, 0.3); }
  
  .btn { 
    background: rgba(0, 243, 255, 0.1); border: 1px solid var(--accent); color: var(--accent);
    border-radius: 3px; padding: 6px 14px; cursor: pointer; font-size: 11px; font-family: var(--font-head);
    text-transform: uppercase; letter-spacing: 1px; font-weight: 600; transition: all 0.2s;
    box-shadow: 0 0 5px rgba(0, 243, 255, 0.2); outline: none;
  }
  .btn:hover { background: var(--accent); color: #000; box-shadow: 0 0 15px rgba(0, 243, 255, 0.6); }
  .btn:active { transform: translateY(1px); }
  
  .statgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 15px; }
  
  /* Config Forms */
  input, select, textarea {
    background: rgba(0,0,0,0.5); border: 1px solid var(--border); color: var(--fg);
    padding: 10px 12px; border-radius: 3px; font-family: var(--font-mono); font-size: 13px;
    transition: border-color 0.2s, box-shadow 0.2s; outline: none; width: 100%;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 8px rgba(0, 243, 255, 0.3); }
  input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; accent-color: var(--accent); }
  
  #cfg-form table { background: var(--panel-bg); border-radius: 4px; border: 1px solid var(--border); box-shadow: inset 0 0 20px rgba(0,0,0,0.5); margin-bottom: 20px; }
  #cfg-form th, #cfg-form td { padding: 15px; border-bottom: 1px solid rgba(255,255,255,0.05); }
  #cfg-form tr:last-child td { border-bottom: none; }
  
  h3 { color: var(--fg); text-shadow: 0 0 5px rgba(255,255,255,0.2); margin-top: 30px; margin-bottom: 15px; border-bottom: 1px solid var(--border); padding-bottom: 8px; display: inline-block; padding-right: 25px; }
</style>
</head>
<body>
<header>
  <div class="dot" id="dot"></div>
  <h1>FAS — NEURAL DASHBOARD</h1>
  <span class="meta" id="hdr-meta">INITIALIZING SYNC...</span>
</header>

<div id="now">
  <div class="stage" id="now-stage">—</div>
  <div class="msg" id="now-msg">AWAITING SYSTEM TELEMETRY...</div>
  <div class="ts" id="now-ts"></div>
</div>

<div id="funnel">
  <div class="card"><div class="n" id="c-pending">0</div><div class="l">PENDING SECURE</div></div>
  <div class="card accent"><div class="n" id="c-claimed">0</div><div class="l">IN FLIGHT</div></div>
  <div class="card accent"><div class="n" id="c-acquired">0</div><div class="l">DATA ACQUIRED</div></div>
  <div class="card green"><div class="n" id="c-processed">0</div><div class="l">THREATS SCANNED</div></div>
  <div class="card"><div class="n" id="c-skipped">0</div><div class="l">BYPASSED</div></div>
  <div class="card red"><div class="n" id="c-failed">0</div><div class="l">ERRORS</div></div>
  <div class="card gold"><div class="n" id="c-findings">0</div><div class="l">ANOMALIES FOUND</div></div>
  <div class="card"><div class="n" id="c-triage">0</div><div class="l">AWAITING TRIAGE</div></div>
  <div class="card"><div class="n" id="c-bw">0</div><div class="l">MB PROCESSED</div></div>
</div>

<nav class="tabs">
  <button class="active" data-pane="activity">SYSTEM LOG</button>
  <button data-pane="findings">ANOMALY REPORTS</button>
  <button data-pane="sources">DIAGNOSTICS</button>
  <button data-pane="suggestions">NEURAL SUGGESTIONS</button>
  <button data-pane="config">CONFIG</button>
</nav>

<div class="pane active" id="pane-activity"><div id="feed"></div></div>

<div class="pane" id="pane-findings">
  <table><thead><tr>
    <th>SEV</th><th>ORIGIN</th><th>SCANNER</th><th>STATUS</th><th>TARGET ID</th>
    <th>COORDINATES</th><th>TRACE PREVIEW</th><th>DEEP CONTEXT</th>
  </tr></thead><tbody id="findings-body"></tbody></table>
</div>

<div class="pane" id="pane-sources">
  <div class="statgrid" id="detector-grid"></div>
  <h3 style="margin-top:24px">RECENT EXECUTION CYCLES</h3>
  <table><thead><tr><th>CYCLE ID</th><th>STAGE</th><th>INITIATED (UTC)</th><th>TERMINATED</th><th>METRICS</th></tr></thead>
  <tbody id="runs-body"></tbody></table>
</div>

<div class="pane" id="pane-suggestions">
  <p class="meta">AI-synthesized discovery vectors. Approved directives are automatically integrated into the primary scanner network.</p>
  <table><thead><tr><th>ID</th><th>VECTOR TYPE</th><th>STATE</th><th>PAYLOAD</th><th>ACTIONS</th></tr></thead>
  <tbody id="sug-body"></tbody></table>
</div>

<div class="pane" id="pane-config">
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; margin-bottom: 20px; padding: 15px 20px; background: var(--panel-bg); border: 1px solid var(--border); border-radius: 4px;">
    <div>
      <h2 style="font-size: 16px; color: var(--accent); margin-bottom: 4px;">SYSTEM CONFIGURATION MATRIX</h2>
      <p class="meta" style="margin: 0;">
        Changes commit to <code>config.local.yaml</code> and hot-apply within one pass. (web.* requires daemon restart).
      </p>
    </div>
    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
      <button class="btn" id="btn-toggle-all-secrets" onclick="toggleAllSecrets()">👁️ SHOW ALL SECRETS</button>
      <button class="btn" onclick="loadConfig()">🔄 REFRESH</button>
      <button class="btn" style="background: rgba(0, 255, 157, 0.15); border-color: var(--green); color: var(--green); font-weight: bold;" onclick="saveConfig()">💾 COMMIT CHANGES</button>
    </div>
  </div>
  
  <div id="cfg-status" style="margin: 10px 0; font-size: 14px; font-weight: bold; min-height: 20px;"></div>

  <div id="cfg-form">
    <div class="meta" style="padding: 20px; text-align: center;">LOADING CONFIGURATION MATRIX...</div>
  </div>

  <div style="margin-top: 25px; display: flex; align-items: center; gap: 15px;">
    <button class="btn" style="background: rgba(0, 255, 157, 0.15); border-color: var(--green); color: var(--green); font-size: 13px; padding: 10px 24px;" onclick="saveConfig()">💾 COMMIT CHANGES</button>
  </div>

  <div style="margin-top: 30px;">
    <details style="background: var(--panel-bg); border: 1px solid var(--border); border-radius: 4px; padding: 15px;">
      <summary style="font-family: var(--font-head); color: var(--accent); cursor: pointer;">VIEW ACTIVE RAW CONFIGURATION (JSON)</summary>
      <pre id="raw-cfg" style="max-width: 100%; margin-top: 15px; color: var(--fg);"></pre>
    </details>
  </div>
</div>

<script>
const TOKEN = {{ '"' + token + '"' if token else 'null' }};
function url(path, params) {
  const p = new URLSearchParams(params || {});
  if (TOKEN) p.set('token', TOKEN);
  const s = p.toString();
  return path + (s ? '?' + s : '');
}
const esc = s => String(s ?? '').replace(/[&<>"']/g,
  c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

let lastId = 0, firstFeed = true;

async function pollState() {
  try {
    const d = await (await fetch(url('/api/state'))).json();
    const c = d.counts.targets_by_status || {};
    set('c-pending', c.pending||0); set('c-claimed', c.claimed||0);
    set('c-acquired', c.acquired||0); set('c-processed', c.processed||0);
    set('c-skipped', c.skipped||0); set('c-failed', c.failed||0);
    set('c-findings', d.counts.findings_total||0);
    set('c-triage', d.counts.findings_pending_triage||0);
    set('c-bw', d.counts.bandwidth_today_mb||0);
    if (d.now_ts) {
      document.getElementById('now-stage').textContent = d.now_stage || '—';
      document.getElementById('now-msg').textContent =
        (d.now_target ? '[' + d.now_target + '] ' : '') + d.now_message;
      document.getElementById('now-ts').textContent = d.now_ts + ' UTC';
      const age = (Date.now() - Date.parse(d.now_ts.replace(' ', 'T') + 'Z')) / 1000;
      document.getElementById('dot').className = 'dot' + (age < 90 ? ' live' : '');
      document.getElementById('hdr-meta').textContent =
        (age < 90 ? 'SYSTEM ONLINE' : 'STANDBY ' + Math.round(age/60) + 'm') +
        ' // LAST SYNC ' + new Date().toLocaleTimeString();
    }
  } catch (e) { document.getElementById('hdr-meta').textContent = 'CONNECTION SEVERED'; }
}

async function pollEvents() {
  const evs = await (await fetch(url('/api/events', {since: lastId}))).json();
  if (!evs.length) return;
  const feed = document.getElementById('feed');
  if (firstFeed) { feed.innerHTML = ''; firstFeed = false; }
  for (const e of evs) {
    lastId = Math.max(lastId, e.id);
    const div = document.createElement('div');
    div.className = 'ev ' + e.level;
    div.innerHTML = `<span class="t">${esc(e.ts)}</span>` +
      `<span class="s">${esc(e.stage)}</span><span class="m">` +
      (e.target ? `[${esc(e.target)}] ` : '') + esc(e.message) + '</span>';
    feed.prepend(div);
  }
  while (feed.children.length > 250) feed.lastChild.remove();
}

async function pollFindings() {
  const rows = await (await fetch(url('/api/findings'))).json();
  document.getElementById('findings-body').innerHTML = rows.map(f => `<tr>
    <td><span class="sev ${esc(f.severity)}">${esc(f.severity)}</span></td>
    <td><span style="color:var(--accent)">${esc(f.service)}</span></td>
    <td>${esc(f.detector)}</td>
    <td><span class="pill ${esc(f.triage_status)}">${esc(f.triage_status)}</span></td>
    <td>${esc(f.target_name)}<br><small style="color:var(--dim)">${esc(f.target_kind)}</small></td>
    <td><code>${esc(f.file_path)}:${f.line}</code></td>
    <td><code id="prev-${f.id}">${esc(f.secret_preview)}</code>
      <button class="btn" style="margin-left: 10px;" onclick="reveal(${f.id})">DECRYPT</button></td>
    <td><details><summary>EXPAND</summary><pre>${esc(f.context)}</pre></details></td>
  </tr>`).join('');
}

async function pollRuns() {
  const rows = await (await fetch(url('/api/runs'))).json();
  document.getElementById('runs-body').innerHTML = rows.map(r =>
    `<tr><td>#${r.id}</td><td><span style="color:var(--accent); font-weight:600;">${esc(r.stage)}</span></td><td>${esc(r.started_at)}</td>
     <td>${esc(r.finished_at || 'IN PROGRESS...')}</td>
     <td><code>${esc(r.stats || '')}</code></td></tr>`).join('');
  const st = await (await fetch(url('/api/state'))).json();
  document.getElementById('detector-grid').innerHTML =
    Object.entries(st.detectors || {}).map(([k, v]) =>
      `<div class="card"><div class="n" style="color:var(--accent);">${v}</div><div class="l">${esc(k)}</div></div>`).join('') ||
    '<p class="meta">NO ANOMALIES LOGGED IN CURRENT CYCLE</p>';
}

async function pollSuggestions() {
  const rows = await (await fetch(url('/api/suggestions'))).json();
  document.getElementById('sug-body').innerHTML = rows.map(s =>
    `<tr><td>#${s.id}</td><td>${esc(s.kind)}</td>
     <td><span class="pill ${s.status === 'approved' ? 'true_positive' : s.status === 'rejected' ? 'false_positive' : 'pending'}">${esc(s.status)}</span></td>
     <td><code>${esc(s.value)}</code></td><td>
     ${s.status === 'pending'
       ? `<button class="btn" style="margin-right: 5px; background: rgba(0, 255, 157, 0.1); border-color: var(--green); color: var(--green);" onclick="sug(${s.id},'approve')">APPROVE</button>
          <button class="btn" style="background: rgba(255, 42, 95, 0.1); border-color: var(--red); color: var(--red);" onclick="sug(${s.id},'reject')">REJECT</button>` : '—'}
     </td></tr>`).join('');
}
async function sug(id, action) {
  await fetch(url(`/api/suggestions/${id}/${action}`), {method: 'POST'});
  pollSuggestions();
}
async function reveal(id) {
  const cell = document.getElementById('prev-' + id);
  cell.textContent = "DECRYPTING...";
  cell.style.color = "var(--dim)";
  const r = await fetch(url(`/api/finding/${id}/reveal`), {method: 'POST'});
  const d = await r.json();
  cell.textContent = d.secret || ('(' + (d.error || 'UNAVAILABLE') + ')');
  cell.style.color = 'var(--gold)';
  cell.style.border = '1px solid var(--gold)';
}

