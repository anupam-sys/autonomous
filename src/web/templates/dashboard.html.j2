const dirty = new Set();
const dig = (o, p) => p.split('.').reduce((a, k) => (a && a[k] !== undefined) ? a[k] : undefined, o);
let allSecretsVisible = false;

async function loadConfig() {
  const statusEl = document.getElementById('cfg-status');
  try {
    const d = await (await fetch(url('/api/config', {reveal: 1}))).json();
    const c = d.config || {}, sset = d.secrets_set || {}, sec = d.secrets || {};
    const form = document.getElementById('cfg-form');

    const rawEl = document.getElementById('raw-cfg');
    if (rawEl) {
      rawEl.textContent = JSON.stringify(c, null, 2);
    }

    form.innerHTML = CFG_SECTIONS.map(([title, fields]) => `
      <h3>${esc(title)}</h3>
      <table><tbody>
      ${fields.map(([p, t, label]) => {
        let input = '';
        if (t === 'bool') {
          const v = dig(c, p);
          input = `<input type="checkbox" data-path="${p}" ${v ? 'checked' : ''}>`;
        } else if (t === 'secret') {
          const secretVal = sec[p] || '';
          const hasVal = Boolean(secretVal || sset[p]);
          input = `
            <div style="display: flex; gap: 8px; align-items: center; max-width: 480px;">
              <input type="${allSecretsVisible ? 'text' : 'password'}" 
                     data-path="${p}" 
                     data-secret="1" 
                     value="${esc(secretVal)}"
                     placeholder="${hasVal ? '•••••••• (SET)' : '(NOT SET)'}"
                     style="flex: 1; letter-spacing: ${allSecretsVisible ? 'normal' : '2px'};">
              <button type="button" class="btn" onclick="toggleFieldSecret('${p}', this)" style="padding: 6px 12px; font-size: 11px;">
                ${allSecretsVisible ? '🔒 HIDE' : '👁️ SHOW'}
              </button>
            </div>`;
        } else if (t === 'list') {
          const v = dig(c, p);
          input = `<textarea data-path="${p}" rows="4" style="width:100%; max-width:480px;">${esc((v || []).join('\n'))}</textarea>`;
        } else if (t.startsWith('choice:')) {
          const v = dig(c, p);
          const opts = t.slice(7).split(',');
          input = `<select data-path="${p}" style="width:100%; max-width:480px;">` + opts.map(o =>
            `<option value="${o}" ${o === v ? 'selected' : ''}>${o.toUpperCase()}</option>`).join('') + '</select>';
        } else {
          const v = dig(c, p);
          input = `<input type="${t === 'str' ? 'text' : 'number'}" data-path="${p}"
                   ${t === 'float' ? 'step="any"' : ''} value="${esc(v ?? '')}" style="width:100%; max-width:480px;">`;
        }
        return `<tr><td style="width:320px; font-weight: 500;">${esc(label)}<br>
          <code style="color:var(--dim); background: transparent; border: none; padding: 0; font-size: 11px;">${p}</code></td><td>${input}</td></tr>`;
      }).join('')}
      </tbody></table>`).join('');

    form.querySelectorAll('input,select,textarea').forEach(el =>
      el.addEventListener('input', () => dirty.add(el.dataset.path)));
  } catch (err) {
    if (statusEl) {
      statusEl.textContent = ' // FAILED TO LOAD CONFIGURATION FROM API';
      statusEl.style.color = 'var(--red)';
    }
  }
}

function toggleFieldSecret(path, btn) {
  const input = document.querySelector(`input[data-path="${path}"]`);
  if (!input) return;
  if (input.type === 'password') {
    input.type = 'text';
    input.style.letterSpacing = 'normal';
    btn.textContent = '🔒 HIDE';
  } else {
    input.type = 'password';
    input.style.letterSpacing = '2px';
    btn.textContent = '👁️ SHOW';
  }
}

function toggleAllSecrets() {
  allSecretsVisible = !allSecretsVisible;
  document.querySelectorAll('input[data-secret="1"]').forEach(input => {
    input.type = allSecretsVisible ? 'text' : 'password';
    input.style.letterSpacing = allSecretsVisible ? 'normal' : '2px';
  });
  document.querySelectorAll('#cfg-form button[type="button"]').forEach(btn => {
    btn.textContent = allSecretsVisible ? '🔒 HIDE' : '👁️ SHOW';
  });
  const masterBtn = document.getElementById('btn-toggle-all-secrets');
  if (masterBtn) {
    masterBtn.textContent = allSecretsVisible ? '🔒 HIDE ALL SECRETS' : '👁️ SHOW ALL SECRETS';
  }
}

async function saveConfig() {
  const updates = {};
  document.querySelectorAll('#cfg-form [data-path]').forEach(el => {
    const p = el.dataset.path, t = el.type;
    if (el.dataset.secret && !dirty.has(p)) return;          // untouched secret = keep
    if (t === 'checkbox') { if (dirty.has(p)) updates[p] = el.checked; return; }
    if (el.tagName === 'TEXTAREA') { if (dirty.has(p)) updates[p] = el.value; return; }
    if (dirty.has(p)) updates[p] = t === 'number' ? Number(el.value) : el.value;
  });
  const st = document.getElementById('cfg-status');
  if (!Object.keys(updates).length) { st.textContent = ' // NO PARAMETERS MODIFIED'; st.style.color = 'var(--dim)'; return; }
  st.textContent = ' // COMMITTING TO CORE...';
  st.style.color = 'var(--gold)';
  
  const r = await fetch(url('/api/config'), {
    method: 'POST', headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({updates}),
  });
  const d = await r.json();
  if (d.ok) {
    dirty.clear();
    st.textContent = ` // MATRIX UPDATED: ${d.applied.join(', ')} (APPLIED ON NEXT CYCLE)`;
    st.style.color = 'var(--green)';
    loadConfig();
  } else {
    st.textContent = ` // FATAL: ${d.error}${d.fields ? ': ' + JSON.stringify(d.fields) : ''}`;
    st.style.color = 'var(--red)';
  }
}

document.querySelectorAll('nav.tabs button').forEach(b =>
  b.addEventListener('click', () => {
    document.querySelectorAll('nav.tabs button').forEach(x => x.classList.remove('active'));
    document.querySelectorAll('.pane').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    document.getElementById('pane-' + b.dataset.pane).classList.add('active');
    if (b.dataset.pane === 'config') {
      loadConfig();
    }
  }));

function set(id, v) { document.getElementById(id).textContent = v; }

